+package org.polyfrost.polyplus.test
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import org.polyfrost.polyplus.client.cosmetics.outfits.LocalSkinIndex
+import org.polyfrost.polyplus.client.cosmetics.outfits.PlayerSkinInfo
+import org.polyfrost.polyplus.client.cosmetics.outfits.SkinModel
+import java.nio.file.Files
+import java.nio.file.Path
+
+class LocalSkinIndexTest {
+    @TempDir
+    lateinit var directory: Path
+
+    @Test
+    fun `local metadata survives restart without an online account`() {
+        val entries = listOf(PlayerSkinInfo(1, "Skin with quotes \" and accents á", SkinModel.Slim,
+            "local:abc", "abc", true, ""))
+        LocalSkinIndex(directory).write(entries)
+        assertEquals(entries, LocalSkinIndex(directory).read())
+        LocalSkinIndex(directory).write(entries.map { it.copy(name = "Renamed", model = SkinModel.Classic) })
+        assertEquals("Renamed", LocalSkinIndex(directory).read().single().name)
+        LocalSkinIndex(directory).write(emptyList())
+        assertEquals(emptyList<PlayerSkinInfo>(), LocalSkinIndex(directory).read())
+    }
+
+    @Test
+    fun `a damaged index is preserved for recovery`() {
+        val path = directory.resolve("library.json")
+        Files.writeString(path, "broken metadata")
+        assertThrows(Exception::class.java) { LocalSkinIndex(directory).read() }
+        assertEquals("broken metadata", Files.readString(path))
+    }
+}
