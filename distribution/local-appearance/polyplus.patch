+package org.polyfrost.polyplus.client.cosmetics
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import net.minecraft.resources.Identifier
+import org.apache.logging.log4j.LogManager
+import org.polyfrost.polyplus.client.PolyPlusClient
+import org.polyfrost.polyplus.client.cosmetics.assets.RemoteTextures
+import org.polyfrost.polyplus.client.cosmetics.outfits.SkinLibrary
+import org.polyfrost.polyplus.client.cosmetics.outfits.SkinModel
+import org.polyfrost.polyplus.client.gui.preview.PreviewSkin
+import org.polyfrost.polyplus.client.utils.ClientPlatform
+import java.awt.image.BufferedImage
+import java.io.ByteArrayInputStream
+import java.nio.file.AtomicMoveNotSupportedException
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.StandardCopyOption
+import java.util.UUID
+import javax.imageio.ImageIO
+
+/** Local profile textures. No account tokens or cosmetic-store calls are used. */
+object OfflineAppearance {
+    private val logger = LogManager.getLogger("polyplus/local-appearance")
+    init { logger.info("Local appearance component active; profile directory: {}", rootPath()) }
+    private fun rootPath() = System.getProperty("oneclient.offline.appearance.dir") ?: "not supplied"
+    private const val LIMIT = 1024 * 1024
+    private val root: Path? = System.getProperty("oneclient.offline.appearance.dir")?.let { Path.of(it) }
+    val enabled: Boolean get() = root?.fileName?.toString() == ClientPlatform.localPlayerUuid().toString() && MojangAuth.accessToken() == null
+
+    private data class Look(val owner: UUID, val skin: PreviewSkin?, val cape: Identifier?)
+    @Volatile private var look: Look? = null
+    @Volatile private var pending = false
+    private var nextPoll = 0L
+    @Volatile private var stamp: String? = null
+
+    @JvmStatic fun skin(owner: UUID): PreviewSkin? {
+        poll()
+        return look?.takeIf { enabled && it.owner == owner && owner == ClientPlatform.localPlayerUuid() }?.skin
+    }
+
+    @JvmStatic fun cape(owner: UUID): Identifier? {
+        poll()
+        return look?.takeIf { enabled && it.owner == owner && owner == ClientPlatform.localPlayerUuid() }?.cape
+    }
+
+    private fun poll() {
+        if (!enabled || pending || System.currentTimeMillis() < nextPoll) return
+        nextPoll = System.currentTimeMillis() + 1000
+        pending = true
+        PolyPlusClient.SCOPE.launch(Dispatchers.IO) {
+            try {
+                val dir = root ?: return@launch
+                val owner = ClientPlatform.localPlayerUuid()
+                val fingerprint = listOf("skin.png", "cape.png", "model.txt").joinToString { name ->
+                    val file = dir.resolve(name)
+                    if (Files.isRegularFile(file)) "$name:${Files.getLastModifiedTime(file)}:${Files.size(file)}" else "$name:absent"
+                }
+                if (stamp == fingerprint) return@launch
+                val slim = Files.isRegularFile(dir.resolve("model.txt")) && Files.readString(dir.resolve("model.txt")).trim() == "slim"
+                val skinId = loadTexture(dir.resolve("skin.png"), false, owner)
+                val capeId = loadTexture(dir.resolve("cape.png"), true, owner)
+                look = Look(owner, skinId?.let { PreviewSkin(it, slim) }, capeId)
+                stamp = fingerprint
+            } catch (error: Exception) {
+                logger.warn("Could not refresh local appearance", error)
+            } finally {
+                pending = false
+            }
+        }
+    }
+
+    private fun loadTexture(file: Path, cape: Boolean, owner: UUID): Identifier? {
+        if (!Files.isRegularFile(file)) return null
+        val image = decode(read(file), cape)
+        val prepared = file.resolveSibling(if (cape) ".render-cape.png" else ".render-skin.png")
+        val normalized = if (cape) image else SkinLibrary.modernLayout(SkinLibrary.previewImage(image))
+        check(ImageIO.write(normalized, "png", prepared.toFile())) { "Could not prepare PNG texture." }
+        val id = Identifier.fromNamespaceAndPath("polyplus", "local/${owner}/${if (cape) "cape" else "skin"}")
+        return RemoteTextures.register(id, prepared, keepOnReset = true)
+    }
+
+    private fun read(file: Path): ByteArray {
+        require(Files.size(file) <= LIMIT) { "PNG files must be smaller than 1 MB." }
+        return Files.readAllBytes(file).also { require(it.size <= LIMIT) { "PNG file is too large." } }
+    }
+
+    internal fun decode(bytes: ByteArray, cape: Boolean): BufferedImage {
+        require(bytes.size <= LIMIT) { "PNG file is too large." }
+        val size = ImageIO.createImageInputStream(ByteArrayInputStream(bytes)).use { input ->
+            val reader = ImageIO.getImageReaders(input).asSequence().firstOrNull() ?: error("Invalid PNG.")
+            try {
+                require(reader.formatName.equals("png", true)) { "Choose a PNG image." }
+                reader.input = input
+                reader.getWidth(0) to reader.getHeight(0)
+            } finally { reader.dispose() }
+        }
+        require(size.first == 64 && (size.second == 32 || (!cape && size.second == 64))) {
+            if (cape) "Capes must be 64 x 32 PNG images." else "Skins must be 64 x 64 or 64 x 32 PNG images."
+        }
+        return ImageIO.read(ByteArrayInputStream(bytes)) ?: error("Invalid PNG.")
+    }
+
+    internal fun directory(): Path {
+        check(enabled) { "Local appearance is not active for this profile." }
+        return root!!
+    }
+
+    internal fun write(file: Path, bytes: ByteArray) {
+        Files.createDirectories(file.parent)
+        val temp = Files.createTempFile(file.parent, ".appearance-", ".tmp")
+        try {
+            Files.write(temp, bytes)
+            try { Files.move(temp, file, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE) }
+            catch (_: AtomicMoveNotSupportedException) { Files.move(temp, file, StandardCopyOption.REPLACE_EXISTING) }
+        } finally { Files.deleteIfExists(temp) }
+    }
+
+    fun importFile(file: Path, cape: Boolean, slim: Boolean) = save(read(file), cape, slim)
+
+    fun slimModel(): Boolean = root?.resolve("model.txt")?.let { file ->
+        Files.isRegularFile(file) && Files.readString(file).trim() == "slim"
+    } ?: false
+
+    fun setSlim(slim: Boolean) {
+        check(enabled)
+        write(root!!.resolve("model.txt"), (if (slim) "slim" else "classic").toByteArray())
+        stamp = null
+    }
+
+    fun save(bytes: ByteArray, cape: Boolean, slim: Boolean) {
+        check(enabled) { "Select an offline profile to use the local wardrobe." }
+        decode(bytes, cape)
+        val dir = root ?: error("Offline profile directory is unavailable.")
+        if (!cape) write(dir.resolve("model.txt"), (if (slim) "slim" else "classic").toByteArray())
+        write(dir.resolve(if (cape) "cape.png" else "skin.png"), bytes)
+        stamp = null
+    }
+
+    suspend fun fromUsername(name: String) {
+        val trimmed = name.trim()
+        require(Regex("^[A-Za-z0-9_]{1,16}$").matches(trimmed)) { "Enter a Minecraft username." }
+        val id = MojangSkinService.uuidForName(trimmed).getOrThrow() ?: error("Player not found.")
+        val skin = MojangSkinService.profileSkin(id).getOrThrow() ?: error("This player has no custom skin.")
+        save(SkinLibrary.fetchSkin(skin.url).getOrThrow(), false, skin.model == SkinModel.Slim)
+    }
+
+    fun clear(cape: Boolean) {
+        check(enabled)
+        Files.deleteIfExists(root!!.resolve(if (cape) "cape.png" else "skin.png"))
+        stamp = null
+    }
+}
