+package org.polyfrost.polyplus.test
+
+import java.awt.image.BufferedImage
+import java.io.ByteArrayOutputStream
+import javax.imageio.ImageIO
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Test
+import org.polyfrost.polyplus.client.cosmetics.OfflineAppearance
+
+class OfflineAppearanceTest {
+    private fun png(width: Int, height: Int): ByteArray = ByteArrayOutputStream().use { out ->
+        ImageIO.write(BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB), "png", out)
+        out.toByteArray()
+    }
+
+    @Test
+    fun `accepts classic and modern skins and cape dimensions`() {
+        assertEquals(64, OfflineAppearance.decode(png(64, 64), false).height)
+        assertEquals(32, OfflineAppearance.decode(png(64, 32), false).height)
+        assertEquals(32, OfflineAppearance.decode(png(64, 32), true).height)
+    }
+
+    @Test
+    fun `rejects malformed oversized and wrong dimension textures`() {
+        assertThrows(IllegalArgumentException::class.java) { OfflineAppearance.decode(png(32, 32), false) }
+        assertThrows(IllegalArgumentException::class.java) { OfflineAppearance.decode(png(64, 64), true) }
+        assertThrows(IllegalArgumentException::class.java) { OfflineAppearance.decode(ByteArray(1024 * 1024 + 1), false) }
+        assertThrows(Exception::class.java) { OfflineAppearance.decode("invalid".toByteArray(), false) }
+    }
+}
