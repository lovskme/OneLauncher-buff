+package org.polyfrost.polyplus.test
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+import org.polyfrost.polyplus.client.cosmetics.LocalEntityAppearance
+import java.util.UUID
+
+class LocalEntityAppearanceTest {
+    private data class Player(var uuid: UUID)
+
+    @Test
+    fun `the live player keeps the local texture when the server replaces its uuid`() {
+        val sessionId = UUID.fromString("c5b5aba2-2e11-3d27-90f6-01ef193d7b45")
+        val player = Player(sessionId)
+        val selectedSkin = "profile-$sessionId-skin.png"
+        assertEquals(selectedSkin, LocalEntityAppearance.resolve(player, player) { selectedSkin })
+        player.uuid = UUID.fromString("fe1baf0b-4fa7-4126-b467-cc2a85b9d80b")
+        assertNotEquals(sessionId, player.uuid)
+        assertEquals(selectedSkin, LocalEntityAppearance.resolve(player, player) { selectedSkin })
+    }
+
+    @Test
+    fun `a different player with the same uuid does not obtain the local texture`() {
+        val uuid = UUID.fromString("c5b5aba2-2e11-3d27-90f6-01ef193d7b45")
+        val local = Player(uuid)
+        val remote = Player(uuid)
+        assertEquals(local, remote)
+        var reads = 0
+        assertNull(LocalEntityAppearance.resolve(remote, local) { reads++; "local-cape.png" })
+        assertEquals(0, reads)
+    }
+
+    @Test
+    fun `a world without a live player does not read local entity textures`() {
+        val candidate = Player(UUID.fromString("c5b5aba2-2e11-3d27-90f6-01ef193d7b45"))
+        var reads = 0
+        assertNull(LocalEntityAppearance.resolve(candidate, null) { reads++; "local-skin.png" })
+        assertEquals(0, reads)
+    }
+}
