+package org.polyfrost.polyplus.client.cosmetics
+
+/** Servers can replace entity UUIDs. Local textures follow the actual live
+ * player object; another entity must never obtain them by copying its UUID. */
+internal object LocalEntityAppearance {
+    fun <T> resolve(entity: Any, livePlayer: Any?, readTexture: () -> T?): T? =
+        if (entity === livePlayer) readTexture() else null
+}
