+package org.polyfrost.polyplus.client.cosmetics.outfits
+
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.polyfrost.polyplus.client.cosmetics.OfflineAppearance
+import java.nio.file.Files
+import java.nio.file.Path
+
+/** Per-profile metadata. A malformed index is reported rather than overwritten. */
+internal class LocalSkinIndex(private val directory: Path) {
+    fun read(): List<PlayerSkinInfo> {
+        val file = directory.resolve("library.json")
+        if (!Files.exists(file)) return emptyList()
+        return Json.decodeFromString<List<SkinResponse>>(Files.readString(file)).map { it.toInfo() }
+    }
+
+    fun write(values: List<PlayerSkinInfo>) {
+        val responses = values.map { SkinResponse(it.id, it.name, it.model.serializedName, it.url, it.hash, it.favorite, it.createdAt) }
+        OfflineAppearance.write(directory.resolve("library.json"), Json.encodeToString(responses).toByteArray())
+    }
+}
