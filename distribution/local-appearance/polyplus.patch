+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.polyfrost.oneconfig.api.ui.v1.api.TinyFdApi
+import org.polyfrost.oneconfig.api.ui.v1.components.Text
+import org.polyfrost.oneconfig.api.ui.v1.components.TextButton
+import org.polyfrost.oneconfig.api.ui.v1.components.TextField
+import org.polyfrost.polyplus.client.cosmetics.OfflineAppearance
+import org.polyfrost.polyplus.client.gui.preview.PlayerPreview
+import org.polyfrost.polyplus.client.gui.preview.PlayerPreviewSource
+
+/** The existing wardrobe opens this page for local offline profiles. */
+@Composable
+internal fun OfflineAppearancePanel(onBack: (() -> Unit)? = null) {
+    val scope = rememberCoroutineScope()
+    var name by remember { mutableStateOf("") }
+    var slim by remember { mutableStateOf(false) }
+    var busy by remember { mutableStateOf(false) }
+    var message by remember { mutableStateOf("Changes are local to this client. Name lookup needs internet.") }
+    LaunchedEffect(Unit) { slim = withContext(Dispatchers.IO) { runCatching { OfflineAppearance.slimModel() }.getOrDefault(false) } }
+
+    fun action(work: suspend () -> Unit) {
+        if (busy) return
+        busy = true
+        scope.launch {
+            message = try {
+                withContext(Dispatchers.IO) { work() }
+                slim = withContext(Dispatchers.IO) { OfflineAppearance.slimModel() }
+                "Appearance saved. It applies in-game automatically."
+            } catch (error: Exception) { error.message ?: "Could not update appearance." }
+            finally { busy = false }
+        }
+    }
+
+    fun choose(cape: Boolean) = action {
+        val file = TinyFdApi.getInstance().openFileSelector(
+            if (cape) "Choose a cape" else "Choose a skin", null, arrayOf("*.png"), "PNG images",
+        ) ?: return@action
+        OfflineAppearance.importFile(file, cape, slim)
+    }
+
+    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(24.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+        onBack?.let { TextButton("Back", { it() }) }
+        Text("Local wardrobe")
+        PlayerPreview(Modifier.fillMaxWidth().height(200.dp), source = PlayerPreviewSource.LocalLive, autoSpin = false, live = true)
+        TextButton("Import skin PNG", { choose(false) })
+        TextButton(if (slim) "Model: slim (click to change)" else "Model: classic (click to change)", {
+            if (!busy) {
+                val next = !slim
+                action { OfflineAppearance.setSlim(next) }
+            }
+        })
+        TextButton("Import cape PNG (64 x 32)", { choose(true) })
+        TextField(value = name, onValueChange = { name = it }, placeholder = "Minecraft username", modifier = Modifier.fillMaxWidth())
+        TextButton("Use skin by username", { action { OfflineAppearance.fromUsername(name) } })
+        TextButton("Remove skin", { action { OfflineAppearance.clear(false) } })
+        TextButton("Remove cape", { action { OfflineAppearance.clear(true) } })
+        Text(if (busy) "Working..." else message)
+    }
+}
