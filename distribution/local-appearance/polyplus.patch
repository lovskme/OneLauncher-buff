+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import org.polyfrost.oneconfig.api.ui.v1.ExperimentalOneConfigUiApi
+import org.polyfrost.oneconfig.api.ui.v1.api.TinyFdApi
+import org.polyfrost.oneconfig.api.ui.v1.components.Text
+import org.polyfrost.oneconfig.api.ui.v1.components.TextButton
+import org.polyfrost.polyplus.client.cosmetics.OfflineAppearance
+
+/** PNG controls displayed inside the existing cape drawer. */
+@Composable
+internal fun LocalCapeControls() {
+    val scope = rememberCoroutineScope()
+    var busy by remember { mutableStateOf(false) }
+    var message by remember { mutableStateOf("Local cape: 64 x 32 PNG") }
+    fun action(remove: Boolean) {
+        if (busy) return
+        busy = true
+        scope.launch {
+            message = try {
+                withContext(Dispatchers.IO) {
+                    if (remove) OfflineAppearance.clear(true) else {
+                        val file = TinyFdApi.getInstance().openFileSelector("Choose a cape", null, arrayOf("*.png"), "PNG images")
+                        if (file != null) OfflineAppearance.importFile(file, true, false)
+                    }
+                }
+                "Local cape updated."
+            } catch (error: Exception) { error.message ?: "Could not update cape." }
+            finally { busy = false }
+        }
+    }
+    Column(Modifier.fillMaxWidth().padding(12.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+        TextButton("Import cape PNG", { action(false) })
+        TextButton("Remove local cape", { action(true) })
+        Text(if (busy) "Working..." else message)
+    }
+}
